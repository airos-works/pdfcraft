name pdfcraft
version 0.15.0~airos1-3
architecture x86_64
summary "PDF reader and editor"
description "PdfCraft for air/OS: read, annotate, edit, organize and save PDFs using the upstream Rust engine, with native Be API windows, file panels and clipboard. Includes the command-line tools."
packager "PdfCraft for air/OS"
vendor "storytold"
copyrights { "2026 PdfCraft contributors" }
licenses { "MIT" "Apache v2" }
urls { "https://github.com/airos-works/pdfcraft" }
provides {
    pdfcraft = 0.15.0
    app:PdfCraft = 0.15.0
    cmd:pdfcraft_cli = 0.15.0
}
requires {
    haiku >= r1~beta6
    lib:libstdc++
    lib:libgcc_s
}
post-install-scripts { "boot/post-install/pdfcraft.sh" }
